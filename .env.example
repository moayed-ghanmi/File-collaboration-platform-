DATABASE_URL="postgresql://filecollab:filecollab@localhost:5432/filecollab?schema=public"
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="filecollab"
S3_SECRET_ACCESS_KEY="filecollab-secret"
S3_BUCKET="filecollab"

# Auth. Generate a real secret for any shared environment: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"
# Optional: enables "Continue with Google". Redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Mailpit from docker compose; inbox at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="FileCollab <no-reply@filecollab.local>"
